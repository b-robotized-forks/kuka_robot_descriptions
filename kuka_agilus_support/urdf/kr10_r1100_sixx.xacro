<?xml version="1.0"?>
<robot name="kuka_kr10" xmlns:xacro="http://wiki.ros.org/xacro">
    <xacro:include filename="$(find kuka_agilus_support)/urdf/kr10_r1100_sixx_macro.xacro"/>
    <xacro:include filename="$(find kuka_agilus_support)/urdf/kr_agilus_ros2_control_macro.xacro"/>
    <!-- Read additional arguments  -->
    <xacro:arg name="driver_version" default="rsi_only"/>
    <xacro:arg name="mode" default="hardware"/>
    <xacro:arg name="use_gpio" default="false"/>
    <xacro:arg name="is_async" default="true"/>
    <xacro:arg name="scheduling_policy" default="slave"/>
    <xacro:arg name="thread_priority" default="30"/>
    <xacro:arg name="cpu_affinity" default="[2,3]"/>
    <xacro:arg name="roundtrip_time" default="0"/>
    <xacro:arg name="client_ip" default="0.0.0.0"/>
    <xacro:arg name="client_port" default="59152"/>
    <xacro:arg name="mxa_client_port" default="1337"/>
    <xacro:arg name="controller_ip" default="0.0.0.0"/>
    <xacro:arg name="verify_robot_model" default="true"/>
    <xacro:arg name="prefix" default=""/>
    <xacro:arg name="x" default="0"/>
    <xacro:arg name="y" default="0"/>
    <xacro:arg name="z" default="0"/>
    <xacro:arg name="roll" default="0"/>
    <xacro:arg name="pitch" default="0"/>
    <xacro:arg name="yaw" default="0"/>
    <xacro:kuka_agilus_ros2_control name="$(arg prefix)kr10_r1100_sixx" driver_version="$(arg driver_version)" client_ip="$(arg client_ip)" client_port="$(arg client_port)" mxa_client_port="$(arg mxa_client_port)" controller_ip="$(arg controller_ip)" prefix="$(arg prefix)" mode="$(arg mode)" use_gpio="$(arg use_gpio)" is_async="$(arg is_async)" scheduling_policy="$(arg scheduling_policy)" thread_priority="$(arg thread_priority)" cpu_affinity="$(arg cpu_affinity)" roundtrip_time="$(arg roundtrip_time)" verify_robot_model="$(arg verify_robot_model)">
        <ext_axes_ros2_control_joints/>
    </xacro:kuka_agilus_ros2_control>
    <!-- world link -->
    <link name="world"/>
    <!-- robot links, joints -->
    <xacro:kuka_kr10_r1100_sixx_robot prefix="$(arg prefix)" package_name="kuka_agilus_support"/>
    <!-- default world - base_link joint -->
    <joint name="$(arg prefix)world-base_link" type="fixed">
        <parent link="world"/>
        <child link="$(arg prefix)base_link"/>
        <origin xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)"/>
    </joint>
</robot>
